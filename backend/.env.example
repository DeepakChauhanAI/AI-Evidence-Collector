# ==============================================================================
# Panacea InfoSec — AI Evidence Collector Environment Configuration
# ==============================================================================
# Copy this file to .env (e.g. `cp .env.example .env`) and populate the values
# needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Agent / LLM Provider Configuration
# ------------------------------------------------------------------------------
# Powers autonomous collection planning, config drafting, control mapping,
# and SOC 2 automated evidence grading. Any OpenAI-compatible endpoint works.
# Leave AI_API_KEY blank to use the deterministic keyword fallback.
AI_API_KEY=your_llm_api_key_here
AI_BASE_URL=https://agentrouter.org/v1
AI_MODEL=deepseek-v4-flash

# Common alternative provider configurations:
# OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
# Local Ollama:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2
# Anthropic (via proxy):
#   AI_BASE_URL=https://api.anthropic.com/v1
#   AI_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 2. AWS Credentials (for 'aws' Evidence Collector)
# ------------------------------------------------------------------------------
# Used by boto3 to audit AWS IAM, CloudTrail, S3, KMS, and GuardDuty.
# Leave unset to use the built-in realistic sample fallback mode for demos,
# or to use local AWS CLI credentials (~/.aws/credentials) / IAM Instance Roles.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=AQoDYXdzEJr... # Optional: required only for temporary STS credentials

# ------------------------------------------------------------------------------
# 3. Application Security & Access Token
# ------------------------------------------------------------------------------
# Shared Bearer token protecting all /api endpoints.
# Leave blank during local development to disable authentication.
# In production, set to a strong random secret (e.g., generated with `openssl rand -hex 32`).
API_TOKEN=

# ------------------------------------------------------------------------------
# 4. Database Configuration
# ------------------------------------------------------------------------------
# SQLite is used by default for local development (creates evidence.db).
# For production or containerized environments, provide a PostgreSQL connection URI:
DATABASE_URL=sqlite:///./evidence.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/evidence

# ------------------------------------------------------------------------------
# 5. Evidence Blob Storage
# ------------------------------------------------------------------------------
# Local filesystem directory where raw evidence artifacts are saved with SHA-256 hashes.
EVIDENCE_DIR=./evidence_store

# ------------------------------------------------------------------------------
# 6. Evidence Discovery (Surface A)
# ------------------------------------------------------------------------------
# Folder the discovery engine scans for candidate evidence documents.
# "Run discovery" in the Discovery view indexes it and suggests matches per control;
# confirming a suggestion binds a `local_file` collector to that path. Candidates can
# only read files under this root, so widening it widens what a binding can collect.
DISCOVERY_DOCS_DIR=./compliance_docs

# Base URL of a public trust centre or internal wiki (Surface C). "Run discovery"
# crawls its sitemap.xml (or the base page's links), keeps same-host pages whose path
# looks like compliance evidence, and suggests them against controls. Discovery only
# records the URL — the existing `document` / `screenshot` collectors fetch it later.
# Left empty, the web surface is skipped.
# DISCOVERY_WEB_URL=https://trust.yourcompany.com

# An S3 bucket of compliance documents (Surface A's remote half). Discovery lists the
# document objects under the prefix and suggests them against controls; confirming one
# binds the `s3_file` collector, which reads the object with boto3. Needs AWS
# credentials (see section 3) — without them the scan simply finds nothing.
DISCOVERY_S3_BUCKET=
DISCOVERY_S3_PREFIX=

# Scanned-PDF reading (vision OCR). OFF unless explicitly enabled.
#
# !! DATA EGRESS: turning this on sends page images of your documents to the LLM
# !! endpoint configured in section 4. It exists for scanned evidence (signed
# !! acknowledgements, photographed policies) that has no text layer to extract, and
# !! it is the only part of discovery where document contents leave this machine.
# !! Everything else — folder, S3, AWS/GitHub descriptors, web crawl, text extraction —
# !! stays local and deterministic.
#
# Only applies to PDFs that yielded no text. Results are cached under
# DISCOVERY_VISION_CACHE, keyed by file hash, so a re-scan does not re-send pages.
# DISCOVERY_VISION_OCR=false
# DISCOVERY_VISION_CACHE=./.vision_cache

# ------------------------------------------------------------------------------
# 7. Failure Alerts & Notifications
# ------------------------------------------------------------------------------
# Slack or Microsoft Teams incoming webhook URL.
# If an evidence collection run fails, an incident alert payload is dispatched here.
# (e.g. https://your-webhook-endpoint.example/services/...)
ALERT_WEBHOOK=

# ------------------------------------------------------------------------------
# 8. Third-Party API Secret Pointers (Referenced via "env:VAR" in configs)
# ------------------------------------------------------------------------------
# Collectors can securely resolve secrets from the environment without storing
# raw credentials in the database (e.g. config: {"headers": {"Authorization": "Bearer env:GITHUB_TOKEN"}}).
GITHUB_TOKEN=your_github_token_here
CLOUDFLARE_API_KEY=your_cloudflare_api_token_here
OKTA_API_TOKEN=your_okta_api_token_here

# GitHub target for Surface B (code) discovery. The `github` collector fills
# {owner}/{repo}/{branch}/{org} in a descriptor endpoint from these. Without them (or
# GITHUB_TOKEN) it stores a labeled sample instead of making the API call, so discovery
# and binding still work — they just aren't real evidence yet.
GITHUB_OWNER=your_org_or_user
GITHUB_REPO=your_repo
GITHUB_BRANCH=main
GITHUB_ORG=your_org

